generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  firstName   String
  lastName    String
  // Provider-neutral storage key (e.g. "avatars/user-1-<hash>.png"), never a
  // URL; null shows initials.
  avatarKey   String?
  userAccount UserAccount?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@map("users")
}

model UserAccount {
  id                Int                @id @default(autoincrement())
  username          String             @unique
  password          String
  user              User               @relation(fields: [userId], references: [id])
  userId            Int                @unique
  messages          Message[]
  userConversations UserConversation[]
  messageReceipts   MessageReceipt[]
  contacts          Contact[]          @relation("ContactOwner")
  contactOf         Contact[]          @relation("ContactTarget")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@map("user_accounts")
}

model Message {
  id              Int              @id @default(autoincrement())
  content         String
  userAccount     UserAccount      @relation(fields: [userAccountId], references: [id])
  userAccountId   Int
  conversation    Conversation     @relation(fields: [conversationId], references: [id])
  conversationId  Int
  messageReceipts MessageReceipt[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@map("messages")
}

model Conversation {
  id                Int                @id @default(autoincrement())
  messages          Message[]
  userConversations UserConversation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@map("conversations")
}

model UserConversation {
  id             Int          @id @default(autoincrement())
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id])
  userAccountId  Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  unreadCount    Int          @default(0)
  // Kept out of this member's conversation list until the first message, so a
  // recipient doesn't see an empty conversation someone else started.
  isHidden       Boolean      @default(false)
  // Set when this member deletes the conversation from their list, which moves
  // it to their archive. Cleared by unarchiving or by a new message.
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([userAccountId, conversationId])
  @@map("user_conversations")
}

model MessageReceipt {
  id            Int         @id @default(autoincrement())
  message       Message     @relation(fields: [messageId], references: [id])
  messageId     Int
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id])
  userAccountId Int
  readAt        DateTime

  @@unique([messageId, userAccountId])
  @@map("message_receipts")
}

// One-way: a row puts contactAccount in userAccount's list only.
model Contact {
  id               Int         @id @default(autoincrement())
  userAccount      UserAccount @relation("ContactOwner", fields: [userAccountId], references: [id])
  userAccountId    Int
  contactAccount   UserAccount @relation("ContactTarget", fields: [contactAccountId], references: [id])
  contactAccountId Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  @@unique([userAccountId, contactAccountId])
  @@map("contacts")
}

// Counters for the Postgres-backed rate limiters (rate-limiter-flexible's
// RateLimiterPrisma). `expire` null means the key never expires.
model RateLimit {
  key    String    @id
  points Int
  expire DateTime?

  @@map("rate_limits")
}
